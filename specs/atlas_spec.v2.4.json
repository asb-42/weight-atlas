    "rough":  {"stat": "kurtosis",       "scale": {"type": "rank_scale", "per_column": true}}
  },
  "grid":  {"upsample": 8, "smooth_sigma": 1.0},
  "sheet": {"contour_levels": 12, "light_azdeg": 315, "light_altdeg": 45, "dpi": 150, "per_row_normalize": true},
  "blender": {"grid": 1024, "resolution": 2048, "z_scale": 0.3},
  "compare": {
    "modes": ["strict", "aligned"],
    "default_mode": "strict",
    "aligned_grid": 64,
    "colormap": "RdBu_r",
    "diverging_clip": 0.98,
    "aligned_interp": "linear"
  },
  "embedding": {
    "method": "pca",
    "grid": 256,
    "components": 3,
    "subsample_scatter": 5000,
    "seeds": {"pca": 0, "umap": 0}
  },
  "seeds": {"svd": 0},
  "vision_slots": [
    "v_attn_q", "v_attn_k", "v_attn_v", "v_attn_qkv", "v_attn_o",
    "v_attn_norm", "v_mlp_norm", "v_mlp_gate", "v_mlp_up", "v_mlp_down", "v_mlp",
    "v_patch_embed", "v_pos_emb", "v_cls", "v_conv", "v_other",
    "mm_projector", "mm_other"
  ],
  "vision_channels": {
    "height": {"stat": "kernel_norm", "pre": "log1p", "scale": {"type": "rank_scale", "per_column": true}},
    "tint":   {"stat": "kurtosis",    "scale": {"type": "robust_scale", "lower": 0.01, "upper": 0.99}},
    "rough":  {"stat": "sparsity",    "scale": {"type": "rank_scale", "per_column": true}}
  },
  "expert_channels": {
    "height": {"stat": "frobenius",   "scale": {"type": "rank_scale", "per_column": true}},
    "tint":   {"stat": "kurtosis",    "scale": {"type": "robust_scale", "lower": 0.01, "upper": 0.99}},
    "rough":  {"stat": "sparsity",    "scale": {"type": "rank_scale", "per_column": true}}
  }
